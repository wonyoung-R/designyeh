lesheet" href="/fonts/paperlogy/paperlogy.css"/><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":["Organization","ProfessionalService"],"@id":"https://dsgnyeh.art/#agency","name":"designYEH","url":"https://dsgnyeh.art/","description":"어떤 일을 하는 곳인지, 왜 믿고 맡길 수 있는지. 사업 소개부터 서비스 안내, 고객 문의까지 담아드립니다.","image":"https://dsgnyeh.art/images/og.jpg","email":"creativebyyeh@gmail.com","areaServed":"KR","knowsLanguage":["ko","en"]},{"@type":"WebSite","@id":"https://dsgnyeh.art/#website","name":"designYEH","url":"https://dsgnyeh.art/","inLanguage":"ko-KR","publisher":{"@id":"https://dsgnyeh.art/#agency"}}]}</script><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="gallery antialiased"><div hidden=""><!--$--><!--/$--></div><a class="skip-link" href="#contact-main">본문으로 이동</a><header class="docent agency-nav"><a class="wordmark" aria-label="designYEH 홈" href="/">designyeh<span class="wm-period">.</span></a><nav class="nav-primary" aria-label="주요 메뉴"><a href="/#works">Works</a><a href="/#services">Services</a><a href="/#approach">Approach</a><a href="/#process">Process</a><a href="/#faq">FAQ</a><a class="nav-contact" aria-current="page" href="/contact/">Contact</a><a href="/pricing/">Pricing</a></nav><details class="nav-mobile"><summary>메뉴 <span aria-hidden="true">＋</span></summary><nav aria-label="모바일 주요 메뉴"><a href="/#works">Works</a><a href="/#services">Services</a><a href="/#approach">Approach</a><a href="/#process">Process</a><a href="/#faq">FAQ</a><a class="nav-contact" aria-current="page" href="/contact/">Contact</a><a href="/pricing/">Pricing</a></nav></details></header><main id="contact-main" tabindex="-1"><section class="room room-studio contact-room" aria-labelledby="contact-title"><div class="room-tag"><span class="tag-no">01</span><span class="tag-name">CONTACT</span><span class="tag-meta">project inquiries</span></div><div class="contact-layout"><div class="contact-intro"><p class="section-kicker">START WITH A NOTE</p><h1 id="contact-title" class="contact-title">홈페이지 제작 <em>문의하기</em></h1><p>어떤 일을 하는 곳인지, 홈페이지에 무엇을 담고 싶은지 알려주세요. 필요한 페이지와 기능을 함께 정리합니다.</p><p><strong>약 15분 무료 상담</strong>으로 사업 규모와 필요한 기능을 확인하고 견적을 드립니다. 기본 랜딩페이지는 30만원이며, 자료·범위 확정 후 합의한 착수 시점부터 12시간 내 완성본을 전달합니다.</p><p>관리자·DB 등 추가 개발은 시간당 75,000원을 시작 기준으로 규모·기간에 따라 단가를 낮춰 협의합니다. 고객 사이트의 유료 서비스 비용은 전액 고객 부담이며, 월 구독료 실비는 관리 작업비와 합산해 안내합니다.</p><div class="contact-service-list" aria-label="홈페이지 제작 안내"><div><span>01</span><strong><a class="service-link" href="/homepage-production/">홈페이지 제작</a></strong><p>기획·디자인·제작·검수·인계</p></div><div><span>02</span><strong><a class="service-link" href="/pricing/">가격 및 수정 정책</a></strong><p>제작 범위와 이용 조건 확인</p></div><div><span>03</span><strong><a class="service-link" href="/pricing/#maintenance">홈페이지 유지관리</a></strong><p>기존 홈페이지도 상담 가능</p></div></div></div><div class="contact-plaque"><h2>상담에 필요한 정보</h2><p class="contact-lead">아는 만큼만 적어도 괜찮습니다. 아래 정보가 있으면 프로젝트의 적합성과 범위를 더 정확히 확인할 수 있습니다.</p><ul class="prep-list"><li><strong>현재 상황</strong><span>사업 소개, 기존 사이트와 개선하고 싶은 점</span></li><li><strong>목표</strong><span>대상 고객과 만들고 싶은 변화</span></li><li><strong>필요한 기능</strong><span>필요한 페이지, 문의 방식과 연동 기능</span></li><li><strong>프로젝트 조건</strong><span>일정·예산 범위, 준비된 콘텐츠, 의사결정자</span></li><li><strong>운영 조건</strong><span>데이터·개인정보, 승인 담당, 오류 시 대체 절차</span></li></ul><div class="contact-email-block"><p class="contact-email-label">EMAIL</p><a class="contact-email" href="mailto:creativebyyeh@gmail.com?subject=designYEH%20%ED%99%88%ED%8E%98%EC%9D%B4%EC%A7%80%20%EC%A0%9C%EC%9E%91%20%EB%AC%B8%EC%9D%98&amp;body=%EC%95%88%EB%85%95%ED%95%98%EC%84%B8%EC%9A%94%2C%20designYEH%EC%97%90%20%ED%99%88%ED%8E%98%EC%9D%B4%EC%A7%80%20%EC%A0%9C%EC%9E%91%EC%9D%84%20%EB%AC%B8%EC%9D%98%ED%95%A9%EB%8B%88%EB%8B%A4.%0A%0A%E2%80%94%20%ED%98%84%EC%9E%AC%20%EC%83%81%ED%99%A9%3A%0A%E2%80%94%20%EB%AA%A9%ED%91%9C%EC%99%80%20%EB%8C%80%EC%83%81%20%EA%B3%A0%EA%B0%9D%3A%0A%E2%80%94%20%ED%95%84%EC%9A%94%ED%95%9C%20%ED%8E%98%EC%9D%B4%EC%A7%80%C2%B7%EA%B8%B0%EB%8A%A5%3A%0A%E2%80%94%20%EC%A4%80%EB%B9%84%EB%90%9C%20%EC%BD%98%ED%85%90%EC%B8%A0%C2%B7%EC%B0%B8%EA%B3%A0%20%EC%9E%90%EB%A3%8C%3A%0A%E2%80%94%20%ED%9D%AC%EB%A7%9D%20%EC%9D%BC%EC%A0%95%EA%B3%BC%20%EC%98%88%EC%82%B0%20%EB%B2%94%EC%9C%84%3A%0A%E2%80%94%20%EC%97%B0%EB%8F%99%20%EC%84%9C%EB%B9%84%EC%8A%A4%C2%B7%EC%B7%A8%EA%B8%89%20%EB%8D%B0%EC%9D%B4%ED%84%B0%20(%ED%95%B4%EB%8B%B9%20%EC%8B%9C)%3A%0A%E2%80%94%20%EC%9D%98%EC%82%AC%EA%B2%B0%EC%A0%95%EC%9E%90%C2%B7%EC%97%B0%EB%9D%BD%EC%B2%98%3A" aria-describedby="contact-privacy">creativebyyeh@gmail.com</a></div><a class="contact-submit" href="mailto:creativebyyeh@gmail.com?subject=designYEH%20%ED%99%88%ED%8E%98%EC%9D%B4%EC%A7%80%20%EC%A0%9C%EC%9E%91%20%EB%AC%B8%EC%9D%98&amp;body=%EC%95%88%EB%85%95%ED%95%98%EC%84%B8%EC%9A%94%2C%20designYEH%EC%97%90%20%ED%99%88%ED%8E%98%EC%9D%B4%EC%A7%80%20%EC%A0%9C%EC%9E%91%EC%9D%84%20%EB%AC%B8%EC%9D%98%ED%95%A9%EB%8B%88%EB%8B%A4.%0A%0A%E2%80%94%20%ED%98%84%EC%9E%AC%20%EC%83%81%ED%99%A9%3A%0A%E2%80%94%20%EB%AA%A9%ED%91%9C%EC%99%80%20%EB%8C%80%EC%83%81%20%EA%B3%A0%EA%B0%9D%3A%0A%E2%80%94%20%ED%95%84%EC%9A%94%ED%95%9C%20%ED%8E%98%EC%9D%B4%EC%A7%80%C2%B7%EA%B8%B0%EB%8A%A5%3A%0A%E2%80%94%20%EC%A4%80%EB%B9%84%EB%90%9C%20%EC%BD%98%ED%85%90%EC%B8%A0%C2%B7%EC%B0%B8%EA%B3%A0%20%EC%9E%90%EB%A3%8C%3A%0A%E2%80%94%20%ED%9D%AC%EB%A7%9D%20%EC%9D%BC%EC%A0%95%EA%B3%BC%20%EC%98%88%EC%82%B0%20%EB%B2%94%EC%9C%84%3A%0A%E2%80%94%20%EC%97%B0%EB%8F%99%20%EC%84%9C%EB%B9%84%EC%8A%A4%C2%B7%EC%B7%A8%EA%B8%89%20%EB%8D%B0%EC%9D%B4%ED%84%B0%20(%ED%95%B4%EB%8B%B9%20%EC%8B%9C)%3A%0A%E2%80%94%20%EC%9D%98%EC%82%AC%EA%B2%B0%EC%A0%95%EC%9E%90%C2%B7%EC%97%B0%EB%9D%BD%EC%B2%98%3A" aria-describedby="contact-privacy">홈페이지 제작 문의하기 →</a><div class="contact-or"><span>또는</span></div><a class="contact-kakao" href="https://open.kakao.com/me/designyeh" target="_blank" rel="noopener noreferrer" aria-describedby="contact-privacy"><span class="kakao-icon" aria-hidden="true">↗</span><span class="kakao-text"><span class="kakao-title">카카오톡 오픈채팅으로 대화하기</span><span class="kakao-sub">designYEH · 카카오톡에서 열립니다 (새 창)</span></span><span class="kakao-arrow" aria-hidden="true">→</span></a><p class="privacy-notice" id="contact-privacy"><strong>문의와 개인정보 안내</strong>이 페이지에는 문의 내용을 입력하거나 제출하는 양식이 없습니다. 이메일·채팅 링크를 누르면 외부 서비스로 이동하며, 메시지는 해당 이메일·채팅 제공업체에서 처리합니다. 비밀번호·API 키·민감한 고객 데이터는 보내지 마세요.</p><p class="contact-hint">상담 후 포함·제외 범위, 고객 제공 자료, 외부 서비스 비용, 개인정보와 권한, 승인·인계·유지관리 기준을 확인합니다.</p></div></div></section></main><footer class="end-label"><span>DESIGNYEH STUDIO</span><a href="/">designYEH — HOME</a><a href="mailto:creativebyyeh@gmail.com">creativebyyeh@gmail.com</a></footer><!--$--><!--/$--><script src="/_next/static/chunks/310vm2bl3xxpt.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/3fntmmi971322.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/3fntmmi971322.js\"],\"default\"]\n4:I[55068,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/1zm6038f4l8y3.js\"],\"SiteNav\"]\n5:I[22016,[\"/_next/static/chunks/3fntmmi971322.js\",\"/_next/static/chunks/1zm6038f4l8y3.js\"],\"\"]\n12:I[68027,[\"/_next/static/chunks/3fntmmi971322.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/2fvamba0m669i.css\",\"style\"]\n:HL[\"/fonts/paperlogy/paperlogy.css\",\"style\"]\n10:X\n0:{\"P\":null,\"c\":[\"\",\"contact\",\"\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"contact\",{\"children\":[\"__PAGE__\",{},\"$undefined\",\"$undefined\",4608]},\"$undefined\",\"$undefined\",4608]},\"$undefined\",\"$undefined\",4624],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2fvamba0m669i.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3fntmmi971322.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\